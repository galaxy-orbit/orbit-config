{
  "name": "@galaxy-stack/orbit-config",
  "version": "0.1.10",
  "description": "Configuration module for Orbit framework",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --packages external",
    "dev": "bun --watch src/index.ts",
    "build:types": "bash scripts/build-types.sh",
    "changeset": "changeset"
  },
  "dependencies": {
    "@galaxy-stack/orbit-core": "^0.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "@changesets/cli": "^2.27.0"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxy-orbit/orbit-config.git"
  },
  "bugs": {
    "url": "https://github.com/galaxy-orbit/orbit-cli/issues"
  },
  "homepage": "https://galaxy-orbit-framework.vercel.app"
}
